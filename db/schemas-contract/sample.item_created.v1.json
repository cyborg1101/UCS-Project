  "$id": "sample.item_created.v1",
  "title": "sample.item_created v1",
  "description": "A sample module item was created",
  "type": "object",
  "properties": {
    "itemId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
